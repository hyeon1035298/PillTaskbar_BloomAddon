# Sources, scripts and the workflow use LF on every platform.
* text=auto eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.md text eol=lf
LICENSE text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Images and binaries are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.dll binary
*.exe binary
*.zip binary
