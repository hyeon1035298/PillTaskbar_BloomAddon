    "tray.panelsNearTray": {
      "name": {
        "ko": "Windows 패널을 트레이 옆에",
        "en": "Windows panels by the tray",
        "ja": "Windows パネルをトレイの横に",
        "zh": "Windows 面板靠近托盘"
      },
      "about": {
        "ko": "빠른 설정과 알림 센터를 화면 끝이 아니라 알약 트레이 옆에 엽니다",
        "en": "Quick Settings and the notification center open by the pill's tray, not at the screen's end",
        "ja": "クイック設定と通知センターを、画面の端ではなくピルのトレイの横に開きます",
        "zh": "快速设置和通知中心在胶囊托盘旁打开，而不是屏幕边缘"
      }
    },
    "tray.centerStill": {
      "name": {
        "ko": "알림 센터 밀려 들어오기 끄기",
        "en": "Notification center without the slide",
        "ja": "通知センターのスライドをオフ",
        "zh": "关闭通知中心滑入动画"
      },
      "about": {
        "ko": "알림 센터와 달력이 옆에서 밀려 들어오지 않고 바로 나타납니다",
        "en": "The notification center and calendar appear in place instead of sliding in",
        "ja": "通知センターとカレンダーが横からスライドせず、その場に表示されます",
        "zh": "通知中心和日历不从侧边滑入，直接在原位显示"
      }
    },
