    "autohide.revealZone": {
      "name": { "ko": "나오는 구간", "en": "Trigger zone", "ja": "表示反応エリア", "zh": "触发区域" },
      "about": {
        "ko": "가장자리의 이 구간 안에서만 포인터로 작업표시줄이 나옵니다. 100이면 가장자리 전체입니다",
        "en": "Reveals the taskbar only when the pointer is within this portion of the edge. 100 means the entire edge",
        "ja": "画面端のこの範囲内でのみポインター操作でタスクバーが表示されます。100 で画面端全体になります",
        "zh": "仅在屏幕边缘的此范围内可通过鼠标呼出任务栏。100 表示整个边缘"
      }
    },
