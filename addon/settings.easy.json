    "autohide.revealZone": {
      "name": { "ko": "나오는 구간", "en": "Reveal zone", "ja": "表示される範囲", "zh": "唤出区域" },
      "about": {
        "ko": "가장자리의 이만큼에서만 포인터로 작업표시줄이 나옵니다. 100이면 가장자리 전체입니다",
        "en": "The pointer brings the taskbar out only on this much of the edge; 100 is all of it",
        "ja": "端のこの範囲でだけ、ポインターでタスクバーが出てきます。100 なら端全体です",
        "zh": "只有在边缘的这一部分，指针才能唤出任务栏。100 为整个边缘"
      }
    },
