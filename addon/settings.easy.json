    "tray.panelsNearTray": {
      "name": {
        "ko": "Windows 패널을 트레이 옆에",
        "en": "Open Windows flyouts near tray",
        "ja": "Windows パネルをトレイの横に開く",
        "zh": "在托盘旁打开 Windows 面板"
      },
      "about": {
        "ko": "빠른 설정과 알림 센터를 화면 끝이 아니라 알약 트레이 옆에 엽니다",
        "en": "Opens Quick Settings and Notification Center next to the pill tray instead of the screen edge",
        "ja": "クイック設定と通知センターを画面端ではなくピルトレイの横に開きます",
        "zh": "在胶囊托盘旁而非屏幕边缘打开快捷设置和通知中心"
      }
    },
    "tray.centerStill": {
      "name": {
        "ko": "알림 센터 밀려 들어오기 끄기",
        "en": "Disable Notification Center slide-in",
        "ja": "通知センターのスライドインを無効化",
        "zh": "关闭通知中心滑入动画"
      },
      "about": {
        "ko": "알림 센터와 달력이 옆에서 밀려 들어오지 않고 바로 나타납니다",
        "en": "Shows Notification Center and Calendar immediately without sliding in from the side",
        "ja": "通知センターとカレンダーが横からスライドせず、すぐに表示されます",
        "zh": "通知中心和日历直接显示，而不从侧边滑入"
      }
    },
    "size.taskbarHeight": {
