    "autohide.keepHiddenForBloom": {
      "name": {
        "ko": "Bloom 런처가 열려도 숨긴 채로",
        "en": "Keep hidden when Bloom launcher opens",
        "ja": "Bloom ランチャーを開いても隠したままにする",
        "zh": "打开 Bloom 启动器时保持隐藏"
      },
      "about": {
        "ko": "끄면 런처를 열 때 그 모니터의 작업표시줄도 함께 나옵니다",
        "en": "When turned off, opening the launcher also reveals the taskbar on that monitor",
        "ja": "オフにすると、ランチャーを開いたときにそのモニターのタスクバーも一緒に表示されます",
        "zh": "关闭后，打开启动器时该显示器的任务栏也会一同显示"
      }
    },
    "autohide.keepHiddenOnFlash": {
      "name": {
        "ko": "앱이 깜박여도 숨긴 채로",
        "en": "Keep hidden when apps flash",
        "ja": "アプリが点滅しても隠したままにする",
        "zh": "应用闪烁提醒时保持隐藏"
      },
      "about": {
        "ko": "끄면 Windows 기본 동작처럼 나와서 그 앱을 열 때까지 유지됩니다",
        "en": "When turned off, pops up as in default Windows and stays visible until the app is opened",
        "ja": "オフにすると、Windows 標準のように表示され、そのアプリを開くまで表示されたままになります",
        "zh": "关闭后将按 Windows 默认行为呼出，并保持显示直到打开该应用"
      }
    },
