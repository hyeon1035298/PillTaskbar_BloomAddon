    "autohide.keepHiddenForBloom": {
      "name": {
        "ko": "Bloom 런처가 열려도 숨긴 채로",
        "en": "Stay hidden for the Bloom launcher",
        "ja": "Bloom ランチャーを開いても隠したまま",
        "zh": "打开 Bloom 启动器时保持隐藏"
      },
      "about": {
        "ko": "끄면 런처를 열 때 그 모니터의 작업표시줄도 함께 나옵니다",
        "en": "Off, opening the launcher brings that monitor's taskbar out too",
        "ja": "オフにすると、ランチャーを開いたときにそのモニターのタスクバーも出てきます",
        "zh": "关闭后，打开启动器时该显示器的任务栏也会一起出现"
      }
    },
    "autohide.keepHiddenOnFlash": {
      "name": {
        "ko": "앱이 깜박여도 숨긴 채로",
        "en": "Stay hidden when an app flashes",
        "ja": "アプリが点滅しても隠したまま",
        "zh": "应用闪烁时保持隐藏"
      },
      "about": {
        "ko": "끄면 Windows처럼 나와서 그 앱을 열 때까지 있습니다",
        "en": "Off, it comes out as in Windows and stays until that app is opened",
        "ja": "オフにすると Windows と同じように出てきて、そのアプリを開くまで残ります",
        "zh": "关闭后会像 Windows 一样出现，直到打开该应用"
